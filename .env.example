# LeafPHP application settings
APP_NAME=LeafPHP
# Environment: local, development, testing, or production.
# Production should always use APP_DEBUG=false.
APP_ENV=local
APP_DEBUG=true
# Optional full base URL. Leave blank for automatic detection.
# Example for XAMPP: http://localhost/myapp
APP_URL=
# Generate with: php leaf key:generate
APP_KEY=
# Default database driver/connection. SQLite works without a database server.
DB_CONNECTION=sqlite
# SQLite file path, relative to the project root unless absolute.
DB_SQLITE_DATABASE=database/database.sqlite
# Prefix applied to Query Builder and Schema table names. Empty means no prefix.
DB_PREFIX=
# Optional MySQL connection for apps that need it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leafphp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Optional second MySQL connection, selectable as mysql_reporting.
DB_REPORTING_HOST=127.0.0.1
DB_REPORTING_PORT=3306
DB_REPORTING_DATABASE=leafphp_reporting
DB_REPORTING_USERNAME=root
DB_REPORTING_PASSWORD=
# file stores sessions in PHP's configured file path; database uses the sessions table.
# For database sessions run: php leaf make:session-migration, then php leaf migrate.
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Optional default authentication filter redirect target.
AUTH_LOGIN_PATH=/login
