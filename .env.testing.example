# Safe defaults for automated tests. Use a separate SQLite file so tests cannot touch your local app data.
APP_NAME=LeafPHP Tests
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
DB_CONNECTION=sqlite
DB_SQLITE_DATABASE=database/database.testing.sqlite
DB_PREFIX=test_
SESSION_DRIVER=file
SESSION_LIFETIME=10
